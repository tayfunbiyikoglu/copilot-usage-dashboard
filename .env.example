# Keep this file committed. Put real secrets in .env, which is gitignored.

# Fine-grained token with Copilot usage metrics permission, or classic PAT with
# the scopes GitHub documents for your org/enterprise endpoint.
GITHUB_TOKEN=github_pat_replace_me

# Use organization unless you specifically need enterprise-level reporting.
GITHUB_COPILOT_SCOPE=organization

# Required when GITHUB_COPILOT_SCOPE=organization.
GITHUB_ORG=your-org-slug

# Required when GITHUB_COPILOT_SCOPE=enterprise.
GITHUB_ENTERPRISE=your-enterprise-slug

# Local API port. Vite proxies /api to this port in development.
PORT=8787
